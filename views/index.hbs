<body>
  <video autoplay muted loop playsinline
    style="position: fixed; top: 0; left: 0;
    width: 100%; height: 100%; object-fit: cover; z-index: -1;">
    <source src="{{backgroundImg}}" type="video/mp4">
  </video>

  <section class="m-5 p-4"
    style="position: relative; background-color: rgba(194, 58, 133, 0.8); border-radius: 16px;">

    <h1 class="text-center text-white mb-4">{{title}}</h1>

    <div class="row g-4">

  <!-- 自己紹介：上段 -->
  <div class="col-12">
    <div class="portfolio-card">
      <h3>自己紹介</h3>
      <p>
        {{#each background}}
        {{this}}
        {{/each}}
      </p>
    </div>
  </div>

  <!-- 興味・専門分野：下段左 -->
  <div class="col-md-6">
    <div class="portfolio-card">
      <h3>興味・専門分野</h3>
      <ul>
        {{#each Interests}}
          <li>{{this}}</li>
        {{/each}}
      </ul>
    </div>
  </div>

  <!-- 今後の目標：下段右 -->
  <div class="col-md-6">
    <div class="portfolio-card">
      <h3>今後の目標</h3>
      <p>
        {{#each Goals}}
        {{this}}
        {{/each}}
      </p>
    </div>
  </div>

</div>
  </section>
</body>