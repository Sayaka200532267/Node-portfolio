<!DOCTYPE html>
<html lang="en">

<head>
  <title>{{title}}</title>
  <link rel="stylesheet" href="/stylesheets/bootstrap.min.css" />
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <script src="/javascripts/bootstrap.min.js" defer></script>
  <link rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="m-0 p-0">

<header>
    <nav class="navbar navbar-expand-lg">
      <div class="container-fluid">
        <a class="navbar-brand text-white" href="/">Node <i class="fab fa-node-js"></i> ポートフォリオ</a>    
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarTogglerDemo03"
          aria-controls="navbarTogglerDemo03" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-end" id="navbarTogglerDemo03">
          <ul class="navbar-nav mb-2 mb-lg-0">
            <li class="nav-item">
            
              <a class="nav-link text-white" href="#about">About Me</a>
            </li>
            <li class="nav-item">
             
              <a class="nav-link text-white" href="#skills">Skills</a>
            </li>
            <li class="nav-item">
              
              <a class="nav-link text-white" href="#resume">Resume</a>
            </li>
            <li class="nav-item">
           
              <a class="nav-link text-white" href="#contact">Contact</a>
            </li>
          </ul>
        </div>

      </div>
    </nav>
  </header>

  <main class="container">
    {{{body}}}

    <!-- About Me セクション (id="about" を追加) -->
    <section id="about" class="m-5 p-4"
      style="position: relative; background-color: rgba(58, 133, 194, 0.8); border-radius: 16px;">

      <h2 class="text-center text-white mb-4">About Me</h2>

      <div class="row g-4">
        <div class="col-12">
          <div class="portfolio-card">
            <ul>
              {{#each aboutData}}
                <li>{{this}}</li>
              {{/each}}
            </ul>
            <p>{{about}}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Skills セクション (id="skills" を追加) -->
    <section id="skills" class="m-5 p-4 text-white"
      style="position: relative; background-color: rgba(40, 140, 120, 0.8); border-radius: 16px;">

      <h2 class="text-center text-white mb-4">Skills</h2>

      <div class="row g-4">
        {{#each skills}}
          <div class="col-md-6"> 
            <div class="portfolio-card h-100">
              <h4 class="text-dark">{{this.type}}</h4>
              <ul>
                {{#each this.lang}}
                  <li>{{this}}</li>
                {{/each}}
              </ul>
            </div>
          </div>
        {{/each}}
      </div>
    </section>

    <!-- Resume セクション (id="resume" を追加) -->
    <section id="resume" class="m-5 p-4 text-white"
      style="position: relative; background-color: rgba(133, 121, 205, 0.8); border-radius: 16px;">

      <h2 class="text-center text-white mb-4">Resume</h2>

      <div class="row g-4">
        <!-- 学歴 -->
        <div class="col-md-6">
          <div class="portfolio-card h-100">
            <h4 class="text-dark">学歴</h4>
            <ul>
              {{#each resume.education}}
                <li class="mb-3">
                  <strong>{{this.school}}</strong><br>
                  {{this.major}} ({{this.year}})<br>
                  <small>{{this.location}}</small>
                  {{#if this.MD}}
                    <br><strong>専攻の概要:</strong> {{this.MD}}
                  {{/if}}
                </li>
              {{/each}}
            </ul>
          </div>
        </div>

        <!-- 経歴 -->
        <div class="col-md-6">
          <div class="portfolio-card h-100">
            <h4 class="text-dark">経歴</h4>
            <ul>
              {{#each resume.experiences}}
                <li class="mb-4">
                  <ul class="list-unstyled" style="padding-left: 0;">
                    <li><strong>職種・タイトル:</strong> {{this.title}}</li>
                    <li><strong>期間:</strong> {{this.year}}</li>
                    <li><strong>活動場所:</strong> {{this.location}}</li>
                    {{#if this.JD}}
                      <li><strong>業務内容:</strong> {{this.JD}}</li>
                    {{/if}}
                    {{#if this.PSKills}}
                      <li>
                        <strong>使用スキル:</strong> 
                        {{#each this.PSKills}}
                          <span class="badge bg-light text-dark me-1">{{this}}</span>
                        {{/each}}
                      </li>
                    {{/if}}
                  </ul>
                </li>
              {{/each}}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact セクション (id="contact" を追加) -->
    <section id="contact" class="m-5 p-4 text-white"
      style="position: relative; background-color: rgba(45, 62, 80, 0.85); border-radius: 16px;">

      <h2 class="text-center text-white mb-4">Contact</h2>

      <div class="row justify-content-center">
        <div class="col-md-8">
          <div class="portfolio-card text-center">
            <p class="fs-5 mb-4">お仕事のご依頼やご相談など、お気軽にお問い合わせください。</p>
                        <div class="mt-3">
              <a href="mailto:{{contact.email}}" class="btn btn-info text-white px-4 py-2 me-2">
                <i class="fas fa-paper-plane me-1"></i> メールを送る
              </a>
            </div>
          </div>
        </div>
      </div>

    </section>

  </main>
  {{!-- Footer --}}
  <footer class="text-white">
    <p>&copy; Node <i class="fab fa-node-js"></i>ポートフォリオ | 小原さやか</p>

    <ul>
      <li>
        <a href="https://github.com/Sayaka200532267"
           class="text-white"
           target="_blank"
           rel="noopener noreferrer">
          <i class="fab fa-github"></i> GitHub
        </a>
      </li>

      <li>
        <a href="https://www.linkedin.com/in/sayaka-ohara-030441264/"
           class="text-white"
           target="_blank"
           rel="noopener noreferrer">
          <i class="fab fa-linkedin"></i> LinkedIn
        </a>
      </li>
    </ul>
  </body>
  </html>